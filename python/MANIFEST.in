exclude .gitignore
exclude .coverage
exclude .coveragerc
include setup.cfg
include README.md
include LICENSE
include binsearch/binsearch.h
include binsearch/pybinsearch.h
prune .cache
prune .git
prune build
prune dist
prune htmlcov
recursive-exclude *.egg-info *
recursive-exclude test/__pycache__ *
recursive-include test *.py
